<Window x:Class="WalkieDohi.Groups.Views.GroupCreateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WalkieDohi.Groups.Views"
        mc:Ignorable="d"
        Title="그룹 만들기"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        MinWidth="520">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 그룹명 -->
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <!-- 검색 -->
            <RowDefinition Height="8"/>
            <RowDefinition Height="300"/>
            <!-- 친구 리스트 -->
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <!-- 옵션/버튼 -->
        </Grid.RowDefinitions>

        <!-- 그룹명 -->
        <StackPanel Orientation="Vertical" Grid.Row="0">
            <TextBlock Text="그룹 이름" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBox x:Name="GroupNameBox" Width="480" Height="28" VerticalContentAlignment="Center"/>
        </StackPanel>

        <!-- 검색 -->
        <StackPanel Orientation="Vertical" Grid.Row="2">
            <TextBlock Text="친구 검색 (이름/IP)" Margin="0,0,0,4"/>
            <TextBox x:Name="SearchBox" Width="480" Height="28" VerticalContentAlignment="Center"
                     TextChanged="SearchBox_TextChanged"/>
        </StackPanel>

        <!-- 친구 리스트 (체크박스 선택) -->
        <ListBox x:Name="FriendListBox"
         Grid.Row="4"
         Width="480"
         BorderThickness="1"
         BorderBrush="#DDD"
         SelectionMode="Single">
            <!-- 선택 모델은 더 이상 필요 없음 -->
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <!-- 행 클릭으로도 체크 토글 -->
                    <EventSetter Event="PreviewMouseLeftButtonUp" Handler="FriendListBox_ItemClick"/>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel LastChildFill="True" Margin="4">
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                          VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Ip}" Foreground="Gray" FontSize="12"/>
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 옵션/버튼 -->
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="본인은 자동 참여됩니다." VerticalAlignment="Center"/>

            <Button Grid.Column="1"
                    Content="결과 전체 선택"
                    Margin="0,0,8,0"
                    Width="90"
                    Height="30"
                    ToolTip="조회된 친구를 전체 선택합니다."
                    Click="SelectAll_Click"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="전체 해제"
                        Margin="0,0,8,0"
                        Width="70"
                        Height="30"
                        Click="ClearSelection_Click"/>
                <Button Content="확인"
                        Margin="0,0,8,0"
                        Width="60"
                        Height="30"
                        IsDefault="True"
                        Click="Ok_Click"/>
                <Button Content="닫기"
                        Width="60"
                        Height="30"
                        IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
