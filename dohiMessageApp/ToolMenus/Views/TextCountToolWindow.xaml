<Window x:Class="WalkieDohi.ToolMenus.Views.TextCountToolWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WalkieDohi.ToolMenus.Views"
        mc:Ignorable="d"
        Title="글자 수 계산기"
        Height="480"
        Width="700"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Segoe UI, Malgun Gothic"
        UseLayoutRounding="True">

    <Border Margin="12"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrushStrong}"
            BorderThickness="1"
            CornerRadius="3"
            Padding="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="텍스트 입력"
                               Style="{StaticResource SectionTitleTextStyle}"/>
                    <TextBlock Text="입력한 텍스트의 길이와 바이트 정보를 계산합니다."
                               Style="{StaticResource CaptionTextStyle}"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <CheckBox x:Name="LinuxModeCheckBox"
                          Grid.Column="1"
                          Content="리눅스(LF)"
                          ToolTip="윈도우는 줄바꿈 2byte, 리눅스는 1byte"
                          Margin="16,0,10,0"
                          VerticalAlignment="Center"
                          Checked="LinuxModeCheckBox_Changed"
                          Unchecked="LinuxModeCheckBox_Changed"/>

                <ComboBox x:Name="EncodingComboBox"
                          Grid.Column="2"
                          Width="160"
                          VerticalAlignment="Center"
                          SelectionChanged="EncodingComboBox_SelectionChanged">
                    <ComboBoxItem Tag="ANSI" IsSelected="True">ANSI 바이트</ComboBoxItem>
                    <ComboBoxItem Tag="UTF8">UTF-8 바이트</ComboBoxItem>
                    <ComboBoxItem Tag="CP949">CP949 바이트</ComboBoxItem>
                    <ComboBoxItem Tag="UTF16">UTF-16 코드 유닛</ComboBoxItem>
                </ComboBox>
            </Grid>

            <TextBox x:Name="InputTextBox"
                     Grid.Row="1"
                     AcceptsReturn="True"
                     VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto"
                     TextWrapping="Wrap"
                     FontSize="13"
                     Padding="10"
                     TextChanged="InputTextBox_TextChanged"/>

            <Border Grid.Row="2"
                    Background="{StaticResource PanelAltBrush}"
                    BorderBrush="{StaticResource BorderBrushStrong}"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="10"
                    Margin="0,10,0,10">
                <UniformGrid Columns="2">
                    <TextBlock x:Name="CharCountText" FontWeight="SemiBold" Margin="0,0,12,4"/>
                    <TextBlock x:Name="LineCountText" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock x:Name="WordCountText" FontWeight="SemiBold" Margin="0,0,12,0"/>
                    <TextBlock x:Name="ByteInfoText" FontWeight="SemiBold"/>
                </UniformGrid>
            </Border>

            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="초기화"
                        Width="86"
                        Height="30"
                        Style="{StaticResource RoundedSettingButtonStyle}"
                        Click="ClearButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
