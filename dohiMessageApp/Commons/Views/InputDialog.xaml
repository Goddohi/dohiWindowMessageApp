<Window x:Class="WalkieDohi.Commons.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        KeyDown="Window_KeyDown"
        Title="입력"
        Height="170"
        Width="340"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Segoe UI, Malgun Gothic"
        UseLayoutRounding="True">
    <Border Margin="12"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrushStrong}"
            BorderThickness="1"
            CornerRadius="3"
            Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="txtBox" Grid.Row="0" Margin="0,0,0,10"/>
            <TextBox x:Name="InputBox" Grid.Row="1" Margin="0,0,0,14"/>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="확인"
                        Width="72"
                        Style="{StaticResource RoundedBasicButtonStyle}"
                        Margin="0,0,8,0"
                        Click="Ok_Click"/>
                <Button Content="취소"
                        Width="72"
                        Click="Cancel_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
