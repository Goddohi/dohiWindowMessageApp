<Window x:Class="WalkieDohi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WalkieDohi"
        mc:Ignorable="d"
        KeyDown="Window_KeyDown"
        Title="WalkieDohi"
        Height="620"
        Width="960"
        MinHeight="560"
        MinWidth="820"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Segoe UI, Malgun Gothic"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="SidebarNavButtonStyle" TargetType="RadioButton">
            <Setter Property="Width" Value="58"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="MainNavigation"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Width="{TemplateBinding Width}"
                              Height="{TemplateBinding Height}">
                            <Border x:Name="SelectedRail"
                                    Width="3"
                                    HorizontalAlignment="Left"
                                    Background="Transparent"
                                    CornerRadius="0,2,2,0"/>
                            <Border x:Name="Chrome"
                                    Margin="8,4"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ButtonHoverBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource PrimaryColor}"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource SecondaryColor}"/>
                                <Setter TargetName="SelectedRail" Property="Background" Value="{StaticResource SecondaryColor}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarIconButtonStyle" TargetType="Button" BasedOn="{StaticResource WalkieButtonBaseStyle}">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="18"/>
        </Style>

        <Storyboard x:Key="ShowToolsPanelStoryboard">
            <DoubleAnimation Storyboard.TargetName="ToolsPanel"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1"
                             Duration="0:0:0.18" />
            <DoubleAnimation Storyboard.TargetName="ToolsPanelTranslate"
                             Storyboard.TargetProperty="Y"
                             From="-12" To="0"
                             Duration="0:0:0.18">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="HideToolsPanelStoryboard">
            <DoubleAnimation Storyboard.TargetName="ToolsPanel"
                             Storyboard.TargetProperty="Opacity"
                             From="1" To="0"
                             Duration="0:0:0.15" />
            <DoubleAnimation Storyboard.TargetName="ToolsPanelTranslate"
                             Storyboard.TargetProperty="Y"
                             From="0" To="-12"
                             Duration="0:0:0.15">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}"
          MouseDown="RootGrid_MouseDown">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="58"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#FFF3F6F8"
                BorderBrush="{StaticResource BorderBrushStrong}"
                BorderThickness="0,0,1,0">
            <Grid>
                <StackPanel VerticalAlignment="Top"
                            Margin="0,14,0,0">
                    <RadioButton x:Name="FriendNavButton"
                                 Content="&#xE77B;"
                                 ToolTip="친구"
                                 Style="{StaticResource SidebarNavButtonStyle}"
                                 Checked="FriendNavButton_Checked"/>
                    <RadioButton x:Name="ChatNavButton"
                                 Content="&#xE8BD;"
                                 ToolTip="채팅방"
                                 Style="{StaticResource SidebarNavButtonStyle}"
                                 Checked="ChatNavButton_Checked"/>
                </StackPanel>

                <StackPanel VerticalAlignment="Bottom"
                            Margin="0,0,0,12">
                    <Button x:Name="SettingButton"
                            Content="&#xE713;"
                            ToolTip="설정"
                            Style="{StaticResource SidebarIconButtonStyle}"
                            Click="OpenSettings_Click"/>
                    <Button x:Name="MenuButton"
                            Content="&#xE712;"
                            ToolTip="도구"
                            Style="{StaticResource SidebarIconButtonStyle}"
                            Click="MenuButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1"
              Background="{StaticResource PanelBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="0,0,0,1"
                    Padding="14,7">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock Text="닉네임"
                               Style="{StaticResource CaptionTextStyle}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBox x:Name="NicknameBox"
                             Width="176"
                             Height="30"
                             Margin="0,0,8,0"
                             Padding="8,3"/>
                    <Button x:Name="SaveUserButton"
                            Content="저장"
                            Style="{StaticResource RoundedBasicButtonStyle}"
                            Click="SaveUserButton_Click"
                            Width="64"
                            Height="30"/>
                </StackPanel>
            </Border>

            <ContentControl x:Name="MainContentHost"
                            Grid.Row="1"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"/>
        </Grid>

        <Border x:Name="ToolsPanel"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Width="224"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrushStrong}"
                BorderThickness="1"
                CornerRadius="3"
                Padding="10"
                Opacity="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="64,0,0,12"
                RenderTransformOrigin="0.5,0"
                IsHitTestVisible="False">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ToolsPanelTranslate" Y="-12" />
            </Border.RenderTransform>

            <StackPanel>
                <TextBlock Text="도구"
                           Style="{StaticResource SectionTitleTextStyle}"
                           Margin="0,0,0,6" />
                <Border Height="1"
                        Background="{StaticResource BorderBrushSoft}"
                        Margin="0,0,0,8"/>

                <Button Content="미니 게임"
                        Style="{StaticResource RoundedSettingButtonStyle}"
                        Margin="0,0,0,4"
                        Height="30"
                        HorizontalContentAlignment="Left"
                        Click="GameButton_Click"/>
                <Button Content="글자 수 계산기"
                        ToolTip="텍스트의 글자 수와 바이트 수를 계산합니다."
                        Style="{StaticResource RoundedSettingButtonStyle}"
                        Margin="0,0,0,4"
                        Height="30"
                        HorizontalContentAlignment="Left"
                        Click="TextCountToolButton_Click"/>
                <Button Content="엑셀 셀 수집기"
                        ToolTip="여러 엑셀 파일에서 지정한 셀 값을 모읍니다."
                        Style="{StaticResource RoundedSettingButtonStyle}"
                        Margin="0,0,0,4"
                        Height="30"
                        HorizontalContentAlignment="Left"
                        Click="ExcelCellCollectorButton_Click"/>
                <Button Content="개발 Git 주소"
                        ToolTip="프로젝트 저장소를 엽니다."
                        Style="{StaticResource RoundedSettingButtonStyle}"
                        Height="30"
                        HorizontalContentAlignment="Left"
                        Click="GitButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
