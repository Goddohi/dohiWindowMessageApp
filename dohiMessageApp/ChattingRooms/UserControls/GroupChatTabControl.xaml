<UserControl x:Class="WalkieDohi.ChattingRooms.UserControls.GroupChatTabControl"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:entity="clr-namespace:WalkieDohi.ChattingRooms.Entity"
      xmlns:conv="clr-namespace:WalkieDohi.Util.TemplateSelectors"
      xmlns:local="clr-namespace:WalkieDohi.ChattingRooms.UserControls"
      mc:Ignorable="d"
      Height="Auto" Width="Auto">
    <UserControl.Resources>
        <conv:DirectionToAlignmentConverter x:Key="DirToAlign"/>
        <conv:DirectionToBubbleBrushConverter x:Key="DirToBubble"
                                              SendBrush="{StaticResource ChatSendBubbleBrush}"
                                              ReceiveBrush="{StaticResource ChatReceiveBubbleBrush}"/>
        <conv:DirectionToForegroundConverter x:Key="DirToFg"
                                             SendForeground="{StaticResource PrimaryButtonTextBrush}"
                                             ReceiveForeground="{StaticResource ChatReceiveTextBrush}"/>
        <conv:DirectionToCornerRadiusConverter x:Key="DirToRadius"
                                               SendRadius="8,8,2,8"
                                               ReceiveRadius="8,8,8,2"/>
        <conv:DirectionToCornerNameViewConverter x:Key="DirToVis"/>

        <Style x:Key="SenderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="Margin" Value="2,0,0,4"/>
        </Style>

        <Style x:Key="TimeTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>

        <Style x:Key="MessageStateTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <Style x:Key="ChatMessageItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GroupHeaderToggleStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinWidth" Value="86"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Background" Value="{StaticResource ButtonBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ButtonHoverBrush}"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource BorderBrushStrong}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource PrimaryColor}"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource SecondaryColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate DataType="{x:Type entity:TextMessage}">
            <StackPanel Margin="10,3" MaxWidth="560"
                        HorizontalAlignment="{Binding Direction, Converter={StaticResource DirToAlign}}">
                <TextBlock Text="{Binding Sender}"
                           Visibility="{Binding Direction, Converter={StaticResource DirToVis}}"
                           Style="{StaticResource SenderTextStyle}"/>
                <Border Padding="10,7"
                        Background="{Binding Direction, Converter={StaticResource DirToBubble}}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="{Binding Direction, Converter={StaticResource DirToRadius}}">
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                               Foreground="{Binding Direction, Converter={StaticResource DirToFg}}"/>
                </Border>
                <TextBlock Style="{StaticResource TimeTextStyle}"
                           HorizontalAlignment="{Binding Direction, Converter={StaticResource DirToAlign}}"
                           Text="{Binding Timestamp, StringFormat={}{0:MM-dd HH:mm}}"/>
                <TextBlock Text="전송중"
                           Style="{StaticResource MessageStateTextStyle}"
                           HorizontalAlignment="{Binding Direction, Converter={StaticResource DirToAlign}}"
                           Visibility="{Binding SendingVisibility}"/>
                <TextBlock Text="{Binding FailureText}"
                           Style="{StaticResource MessageStateTextStyle}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource DangerBrush}"
                           HorizontalAlignment="{Binding Direction, Converter={StaticResource DirToAlign}}"
                           Visibility="{Binding FailedVisibility}"
                           ToolTip="{Binding FailureDetail}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type entity:ImageMessage}">
            <StackPanel Margin="10,3" MaxWidth="560"
                        HorizontalAlignment="{Binding Direction, Converter={StaticResource DirToAlign}}">
                <TextBlock Text="{Binding Sender}"
                           Visibility="{Binding Direction, Converter={StaticResource DirToVis}}"
                           Style="{StaticResource SenderTextStyle}"/>
                <Border Padding="6"
                        Background="{Binding Direction, Converter={StaticResource DirToBubble}}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="{Binding Direction, Converter={StaticResource DirToRadius}}">
                    <Image MaxWidth="520" MaxHeight="300" Stretch="Uniform"
                           Source="{Binding Image}"/>
                </Border>
                <TextBlock Style="{StaticResource TimeTextStyle}"
                           HorizontalAlignment="{Binding Direction, Converter={StaticResource DirToAlign}}"
                           Text="{Binding Timestamp, StringFormat={}{0:MM-dd HH:mm}}"/>
                <TextBlock Text="전송중"
                           Style="{StaticResource MessageStateTextStyle}"
                           HorizontalAlignment="{Binding Direction, Converter={StaticResource DirToAlign}}"
                           Visibility="{Binding SendingVisibility}"/>
                <TextBlock Text="{Binding FailureText}"
                           Style="{StaticResource MessageStateTextStyle}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource DangerBrush}"
                           HorizontalAlignment="{Binding Direction, Converter={StaticResource DirToAlign}}"
                           Visibility="{Binding FailedVisibility}"
                           ToolTip="{Binding FailureDetail}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type entity:FileMessage}">
            <StackPanel Margin="10,3" MaxWidth="560"
                        HorizontalAlignment="{Binding Direction, Converter={StaticResource DirToAlign}}">
                <TextBlock Text="{Binding Sender}"
                           Visibility="{Binding Direction, Converter={StaticResource DirToVis}}"
                           Style="{StaticResource SenderTextStyle}"/>
                <Border Padding="10,7"
                        Background="{Binding Direction, Converter={StaticResource DirToBubble}}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="{Binding Direction, Converter={StaticResource DirToRadius}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="파일"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   Foreground="{Binding Direction, Converter={StaticResource DirToFg}}"
                                   Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding FileName}"
                                   Foreground="{Binding Direction, Converter={StaticResource DirToFg}}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding FilePath}"/>
                    </StackPanel>
                </Border>
                <TextBlock Style="{StaticResource TimeTextStyle}"
                           HorizontalAlignment="{Binding Direction, Converter={StaticResource DirToAlign}}"
                           Text="{Binding Timestamp, StringFormat={}{0:MM-dd HH:mm}}"/>
                <TextBlock Text="전송중"
                           Style="{StaticResource MessageStateTextStyle}"
                           HorizontalAlignment="{Binding Direction, Converter={StaticResource DirToAlign}}"
                           Visibility="{Binding SendingVisibility}"/>
                <TextBlock Text="{Binding FailureText}"
                           Style="{StaticResource MessageStateTextStyle}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource DangerBrush}"
                           HorizontalAlignment="{Binding Direction, Converter={StaticResource DirToAlign}}"
                           Visibility="{Binding FailedVisibility}"
                           ToolTip="{Binding FailureDetail}"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{StaticResource PanelBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrushStrong}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="GroupTitleText"
                               Text="그룹 채팅"
                               Style="{StaticResource SectionTitleTextStyle}"
                               FontSize="15"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="GroupMemberSummaryText"
                               Text="그룹원"
                               Style="{StaticResource CaptionTextStyle}"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <ToggleButton x:Name="GroupMemberToggle"
                              Grid.Column="1"
                              Content="그룹원"
                              Style="{StaticResource GroupHeaderToggleStyle}"
                              VerticalAlignment="Center"/>

                <Popup PlacementTarget="{Binding ElementName=GroupMemberToggle}"
                       Placement="Bottom"
                       IsOpen="{Binding IsChecked, ElementName=GroupMemberToggle}"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Fade">
                    <Border Width="260"
                            MaxHeight="240"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrushStrong}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="그룹원"
                                       Style="{StaticResource SectionTitleTextStyle}"
                                       Margin="0,0,0,8"/>
                            <ListBox x:Name="GroupMemberList"
                                     Grid.Row="1"
                                     MaxHeight="190"
                                     DisplayMemberPath="DisplayText"
                                     FontWeight="Normal"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Padding="0"/>
                        </Grid>
                    </Border>
                </Popup>
            </Grid>
        </Border>

        <ListBox x:Name="ChatList"
                 Grid.Row="1"
                 Background="{StaticResource ChatCanvasBrush}"
                 BorderThickness="0"
                 Padding="6"
                 SelectionMode="Single"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 AllowDrop="True"
                 ItemsSource="{Binding ChatMessages}"
                 ItemContainerStyle="{StaticResource ChatMessageItemStyle}"
                 MouseDoubleClick="ChatList_MouseDoubleClick"
                 MouseRightButtonUp="ChatList_MouseRightButtonUp"
                 DragEnter="ChatList_DragEnter"
                 Drop="ChatList_Drop"
                 PreviewKeyDown="ChatList_PreviewKeyDown"
                 PreviewMouseWheel="ChatList_ScrollChanged"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel IsVirtualizing="True" VirtualizationMode="Recycling" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>

        <Button Grid.Row="1"
                x:Name="ScrollToBottomButton"
                Content="v"
                Width="28"
                Height="28"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,20,16"
                Visibility="Collapsed"
                Style="{StaticResource IconButtonStyle}"
                Click="ScrollToBottomButton_Click"/>

        <local:DoodlePadControl x:Name="DoodlePad"
                                Visibility="Collapsed"
                                Grid.Row="1"
                                DoodleCompleted="DoodlePad_DoodleCompleted"/>

        <Border Grid.Row="2"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrushStrong}"
                BorderThickness="0,1,0,0"
                Padding="10">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         x:Name="InputBox"
                         MinHeight="32"
                         Margin="0,0,6,0"
                         PreviewKeyDown="InputBox_PreviewKeyDown"
                         AcceptsReturn="True" />
                <Button Grid.Column="1"
                        x:Name="SendButton"
                        Content="전송"
                        Style="{StaticResource RoundedBasicButtonStyle}"
                        Width="64"
                        Height="32"/>
                <Button Grid.Column="2"
                        Content="파일"
                        Style="{StaticResource RoundedChatButtonStyle}"
                        Width="64"
                        Height="32"
                        Margin="6,0,0,0"
                        Click="SendFileButton_Click"/>
                <Button Grid.Column="3"
                        Content="낙서"
                        Style="{StaticResource RoundedChatButtonStyle}"
                        Width="64"
                        Height="32"
                        Margin="6,0,0,0"
                        Click="BtnDoodle_Click"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
