<UserControl x:Class="WalkieDohi.ChattingRooms.UserControls.GroupChatTabControl"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:entity="clr-namespace:WalkieDohi.ChattingRooms.Entity"
      xmlns:conv="clr-namespace:WalkieDohi.Util.TemplateSelectors"
      xmlns:local="clr-namespace:WalkieDohi.ChattingRooms.UserControls"
      mc:Ignorable="d" 
      Height="Auto" Width="Auto">
    <UserControl.Resources>
        <!-- 컨버터 등록 -->
        <conv:DirectionToAlignmentConverter x:Key="DirToAlign"/>
        <conv:DirectionToBubbleBrushConverter x:Key="DirToBubble"/>
        <conv:DirectionToForegroundConverter x:Key="DirToFg"/>
        <conv:DirectionToCornerRadiusConverter x:Key="DirToRadius"/>
        <conv:DirectionToCornerNameViewConverter x:Key="DirToVis"/>

        <!-- 공통: 시간 텍스트 스타일 -->
        <Style x:Key="TimeTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#7A7A7A"/>
            <Setter Property="Margin" Value="6,2,0,0"/>
        </Style>

        <!-- 텍스트 메시지 -->
        <DataTemplate DataType="{x:Type entity:TextMessage}">
            <StackPanel Margin="8,2" MaxWidth="560"
                    HorizontalAlignment="{Binding Direction, Converter={StaticResource DirToAlign}}">

                <TextBlock Text="{Binding Sender}" Visibility="{Binding Direction, Converter={StaticResource DirToVis}}"  FontWeight="Bold"/>
                <Border Padding="10"
                    Background="{Binding Direction, Converter={StaticResource DirToBubble}}"
                    CornerRadius="{Binding Direction, Converter={StaticResource DirToRadius}}">
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                           Foreground="{Binding Direction, Converter={StaticResource DirToFg}}"/>
                </Border>
                <TextBlock Style="{StaticResource TimeTextStyle}"
                       HorizontalAlignment="{Binding Direction, Converter={StaticResource DirToAlign}}"
                       Margin="0,2,0,0"
                       Text="{Binding Timestamp, StringFormat={}{0:MM-dd HH:mm}}"/>
                <TextBlock Text="전송중"
                       FontSize="11"
                       Foreground="#64748B"
                       HorizontalAlignment="{Binding Direction, Converter={StaticResource DirToAlign}}"
                       Visibility="{Binding SendingVisibility}"/>
                <TextBlock Text="{Binding FailureText}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="#DC2626"
                       HorizontalAlignment="{Binding Direction, Converter={StaticResource DirToAlign}}"
                       Visibility="{Binding FailedVisibility}"
                       ToolTip="{Binding FailureDetail}"/>
            </StackPanel>
        </DataTemplate>

        <!-- 이미지 메시지 -->
        <DataTemplate DataType="{x:Type entity:ImageMessage}">
            <StackPanel Margin="8,2" MaxWidth="560"
                    HorizontalAlignment="{Binding Direction, Converter={StaticResource DirToAlign}}">

                <TextBlock Text="{Binding Sender}" Visibility="{Binding Direction, Converter={StaticResource DirToVis}}" FontWeight="Bold"/>
                <Border Padding="6"
                    Background="{Binding Direction, Converter={StaticResource DirToBubble}}"
                    CornerRadius="{Binding Direction, Converter={StaticResource DirToRadius}}">
                    <Image MaxWidth="520" MaxHeight="300" Stretch="Uniform"
                       Source="{Binding Image}"/>
                </Border>
                <TextBlock Style="{StaticResource TimeTextStyle}"
                       HorizontalAlignment="{Binding Direction, Converter={StaticResource DirToAlign}}"
                       Margin="0,2,0,0"
                       Text="{Binding Timestamp, StringFormat={}{0:MM-dd HH:mm}}"/>
                <TextBlock Text="전송중"
                       FontSize="11"
                       Foreground="#64748B"
                       HorizontalAlignment="{Binding Direction, Converter={StaticResource DirToAlign}}"
                       Visibility="{Binding SendingVisibility}"/>
                <TextBlock Text="{Binding FailureText}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="#DC2626"
                       HorizontalAlignment="{Binding Direction, Converter={StaticResource DirToAlign}}"
                       Visibility="{Binding FailedVisibility}"
                       ToolTip="{Binding FailureDetail}"/>
            </StackPanel>
        </DataTemplate>

        <!-- 파일 메시지 -->
        <DataTemplate DataType="{x:Type entity:FileMessage}">
            <StackPanel Margin="8,2" MaxWidth="560"
                    HorizontalAlignment="{Binding Direction, Converter={StaticResource DirToAlign}}">

                <TextBlock Text="{Binding Sender}"  Visibility="{Binding Direction, Converter={StaticResource DirToVis}}" FontWeight="Bold"/>
                <Border Padding="10"
                    Background="{Binding Direction, Converter={StaticResource DirToBubble}}"
                    CornerRadius="{Binding Direction, Converter={StaticResource DirToRadius}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📎 " FontSize="14"
                               Foreground="{Binding Direction, Converter={StaticResource DirToFg}}"
                               Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding FileName}"
                               Foreground="{Binding Direction, Converter={StaticResource DirToFg}}"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}"/>
                    </StackPanel>
                </Border>
                <TextBlock Style="{StaticResource TimeTextStyle}"
                       HorizontalAlignment="{Binding Direction, Converter={StaticResource DirToAlign}}"
                       Margin="0,2,0,0"
                       Text="{Binding Timestamp, StringFormat={}{0:MM-dd HH:mm}}"/>
                <TextBlock Text="전송중"
                       FontSize="11"
                       Foreground="#64748B"
                       HorizontalAlignment="{Binding Direction, Converter={StaticResource DirToAlign}}"
                       Visibility="{Binding SendingVisibility}"/>
                <TextBlock Text="{Binding FailureText}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="#DC2626"
                       HorizontalAlignment="{Binding Direction, Converter={StaticResource DirToAlign}}"
                       Visibility="{Binding FailedVisibility}"
                       ToolTip="{Binding FailureDetail}"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- Expander -->
            <RowDefinition Height="*" />
            <!-- Chat list -->
            <RowDefinition Height="Auto" />
            <!-- Input & Send -->
        </Grid.RowDefinitions>

        <!-- 그룹원 목록 Expander -->
        <Expander Header="그룹원 보기" Grid.Row="0" Margin="5" IsExpanded="False" x:Name="GroupMemberList_viewr"  FontWeight="Bold" >
            <ListBox x:Name="GroupMemberList" Height="100" DisplayMemberPath="DisplayText"  FontWeight="Normal"/>
        </Expander>

        <!-- 채팅 메시지 리스트 -->
        <ListBox x:Name="ChatList" 
                   SelectionMode="Single"
                   VirtualizingPanel.ScrollUnit="Pixel" 
                   AllowDrop="True"
                   ItemsSource="{Binding ChatMessages}"
                   MouseDoubleClick="ChatList_MouseDoubleClick" 
                   MouseRightButtonUp="ChatList_MouseRightButtonUp"
                   DragEnter="ChatList_DragEnter"
                   Drop="ChatList_Drop"
                   PreviewKeyDown="ChatList_PreviewKeyDown"
                   PreviewMouseWheel="ChatList_ScrollChanged" 
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   Grid.Row="1" Margin="5">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel IsVirtualizing="True" VirtualizationMode="Recycling" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>

        <Button Grid.Row="1"
            x:Name="ScrollToBottomButton"
            Content="▼"
            Width="25" Height="25"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="10,10,30,20"
            Visibility="Collapsed"
            Style="{StaticResource RoundedChatButtonStyle}"
            Click="ScrollToBottomButton_Click"/>


        <!-- 낙서 패드: 항상 위에 띄우되 기본은 Collapsed -->
        <local:DoodlePadControl x:Name="DoodlePad"
                                Visibility="Collapsed"
                                Grid.Row="1"
                                DoodleCompleted="DoodlePad_DoodleCompleted"/>

        <!-- 입력창 및 버튼 -->
        <Grid Grid.Row="2" Margin="5" VerticalAlignment="Center" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition MinWidth="80" Width="300*"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" x:Name="InputBox"  Width="300" Height="30" Margin="0,0,5,0" 
                     PreviewKeyDown="InputBox_PreviewKeyDown" AcceptsReturn="True" />
            <Button Grid.Column="1" x:Name="SendButton" Content="전송" 
                    Style="{StaticResource RoundedChatButtonStyle}" Width="60" Height="30"/>
            <Button Grid.Column="2" Content="파일 전송" Margin="10,0,0,0" 
                    Style="{StaticResource RoundedChatButtonStyle}" Width="80" Height="30" Click="SendFileButton_Click"/>
            <!-- 메시지 리스트, 입력박스 등... -->
            <Button Content="낙서" Grid.Column="3"  Width="60" Height="30"
                    Style="{StaticResource RoundedChatButtonStyle}"  
                    VerticalAlignment="Bottom"
                    Click="BtnDoodle_Click"/>
        </Grid>
    </Grid>
</UserControl>
