<Window x:Class="WalkieDohi.ChattingRooms.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Width="300" Height="140"
        Loaded="ToastWindow_Loaded"
        FontFamily="Segoe UI, Malgun Gothic"
        UseLayoutRounding="True">

    <Border Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrushStrong}"
            BorderThickness="1"
            CornerRadius="4"
            Padding="12"
            Opacity="0.98"
            MouseLeftButtonDown="Window_MouseLeftButtonDown">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Top"
                        Margin="0,0,0,10"
                        Grid.Row="0">
                <Image Width="22" Height="22"
                       Source="{StaticResource WalkieDohiLogo}"
                       Margin="0,0,6,0"/>
                <TextBlock Text="워키도히 알림"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextBrush}"
                           FontWeight="SemiBold"
                           FontSize="14"/>
            </StackPanel>

            <StackPanel Grid.Row="1">
                <TextBlock x:Name="TitleText"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,6"/>
                <TextBlock x:Name="MessageText"
                           FontSize="12"
                           Foreground="{StaticResource MutedTextBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
