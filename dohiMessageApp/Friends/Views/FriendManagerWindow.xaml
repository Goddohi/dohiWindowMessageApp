<Window x:Class="WalkieDohi.Friends.Views.FriendManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        KeyDown="Window_KeyDown"
        Title="친구추가"
        Height="285"
        Width="400"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Segoe UI, Malgun Gothic"
        UseLayoutRounding="True">

    <Border Margin="12"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrushStrong}"
            BorderThickness="1"
            CornerRadius="3"
            Padding="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock x:Name="TitleText"
                           Text="친구추가"
                           Style="{StaticResource SectionTitleTextStyle}"
                           FontSize="18"
                           Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="68"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="이름" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" x:Name="NameBox" KeyDown="txtAddBox_KeyDown" TextChanged="Input_TextChanged"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="68"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="IP 주소" VerticalAlignment="Center"/>
                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="IpBox1" MaxLength="3" InputMethod.IsInputMethodEnabled="False" InputScope="Number" PreviewTextInput="IpBox_PreviewTextInput" TextChanged="IpBox_TextChanged" DataObject.Pasting="IpBox_Pasting" KeyDown="txtAddBox_KeyDown"/>
                        <TextBlock Grid.Column="1" Text="." Margin="4,0" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="2" x:Name="IpBox2" MaxLength="3" InputMethod.IsInputMethodEnabled="False" InputScope="Number" PreviewTextInput="IpBox_PreviewTextInput" TextChanged="IpBox_TextChanged" DataObject.Pasting="IpBox_Pasting" KeyDown="txtAddBox_KeyDown"/>
                        <TextBlock Grid.Column="3" Text="." Margin="4,0" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="4" x:Name="IpBox3" MaxLength="3" InputMethod.IsInputMethodEnabled="False" InputScope="Number" PreviewTextInput="IpBox_PreviewTextInput" TextChanged="IpBox_TextChanged" DataObject.Pasting="IpBox_Pasting" KeyDown="txtAddBox_KeyDown"/>
                        <TextBlock Grid.Column="5" Text="." Margin="4,0" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="6" x:Name="IpBox4" MaxLength="3" InputMethod.IsInputMethodEnabled="False" InputScope="Number" PreviewTextInput="IpBox_PreviewTextInput" TextChanged="IpBox_TextChanged" DataObject.Pasting="IpBox_Pasting" KeyDown="txtAddBox_KeyDown"/>
                        <Button Grid.Column="7"
                                x:Name="btnLookupProfile"
                                Content="연결확인"
                                Width="72"
                                Margin="8,0,0,0"
                                Click="LookupProfile_Click"/>
                    </Grid>
                </Grid>

                <TextBlock x:Name="LookupStatusTextBlock"
                           Text=""
                           Style="{StaticResource CaptionTextStyle}"
                           Margin="68,7,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,12,0,0">
                <Button Content="친구추가"
                        Width="82"
                        Style="{StaticResource RoundedBasicButtonStyle}"
                        x:Name="btnAddFriend"
                        IsEnabled="False"
                        Click="AddFriend_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
