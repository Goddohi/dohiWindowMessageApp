<UserControl x:Class="WalkieDohi.Friends.UserControls.FriendMainListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:util="clr-namespace:WalkieDohi.Util"
             Height="Auto" Width="Auto">
    <UserControl.Resources>
        <util:StringNullOrEmptyToVisibilityConverter x:Key="StringNullOrEmptyToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="150"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*" MinWidth="150"/>
        </Grid.ColumnDefinitions>

        <!-- 친구 영역 -->
        <Grid Grid.Column="0" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- 버튼 + 검색 -->
                <RowDefinition Height="*"/>
                <!-- 리스트 -->
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <!-- 텍스트 -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- 버튼 -->
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="친구를 검색하세요"   VerticalAlignment="Center"  FontWeight="Bold"/>

                    <Button x:Name="ManageFriendsButton"
                        Grid.Column="1"
                        Content="친구 관리"
                        Style="{StaticResource RoundedSettingButtonStyle}"
                        Click="ManageFriends_Click"
                        Height="30"
                        Margin="10,0,0,0"/>
                </Grid>

                <Grid>
                    <TextBox x:Name="FriendSearchBox"
                             Height="30"
                             VerticalContentAlignment="Center"
                             FontSize="14"
                             TextChanged="FriendSearchBox_TextChanged"/>
                    <TextBlock Text="친구 이름 또는 IP 검색..."
                               Foreground="Gray"
                               Margin="5,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="{Binding Text, ElementName=FriendSearchBox, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"/>
                </Grid>
            </StackPanel>

            <ListBox x:Name="FriendListBox"
                     Grid.Row="1"
                     Margin="0,10,0,0"
                     DisplayMemberPath="DisplayName"
                     MouseDoubleClick="FriendListBox_MouseDoubleClick"
                     MouseRightButtonUp="FriendListBox_MouseRightButtonUp"
                     VerticalAlignment="Stretch"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
        </Grid>

    </Grid>
</UserControl>
